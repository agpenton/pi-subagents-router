{
  "name": "pi-subagents-router",
  "version": "1.0.0",
  "description": "A Pi extension that routes agents based on task descriptions using useWhen and avoidWhen criteria",
  "type": "module",
  "main": "./dist/agent-router.js",
  "types": "./dist/agent-router.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/agent-router.d.ts",
        "default": "./dist/agent-router.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --require ts-node/register test/test-supervisor.ts",
    "test:router": "node test/test-routing.ts"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "extension",
    "agent",
    "routing",
    "ai"
  ],
  "author": "Asdrubal",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "typebox": "^1.3.0"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "pi": {
    "extensions": [
      "./dist/agent-router.js"
    ]
  }
}
